[36m(main_task pid=13624)[0m def create_tree(parent, N):
[36m(main_task pid=13624)[0m     # Create an empty dictionary to store the nodes
[36m(main_task pid=13624)[0m     tree = {}
[36m(main_task pid=13624)[0m     # Create an empty queue to perform level order traversal
[36m(main_task pid=13624)[0m     queue = []
[36m(main_task pid=13624)[0m     # Add the root node to the queue
[36m(main_task pid=13624)[0m     queue.append(0)
[36m(main_task pid=13624)[0m     # Iterate through the parent array
[36m(main_task pid=13624)[0m     for i in range(N):
[36m(main_task pid=13624)[0m         # If the current node has a parent, add it to the tree
[36m(main_task pid=13624)[0m         if parent[i] != -1:
[36m(main_task pid=13624)[0m             tree[i] = parent[i]
[36m(main_task pid=13624)[0m             queue.append(parent[i])
[36m(main_task pid=13624)[0m     # Perform level order traversal to create the binary tree
[36m(main_task pid=13624)[0m     while queue:
[36m(main_task pid=13624)[0m         current = queue.pop(0)
[36m(main_task pid=13624)[0m         left = current * 2
[36m(main_task pid=13624)[0m         right = current * 2 + 1
[36m(main_task pid=13624)[0m         if left < N:
[36m(main_task pid=13624)[0m             tree[left] = current
[36m(main_task pid=13624)[0m             queue.append(left)
[36m(main_task pid=13624)[0m         if right < N:
[36m(main_task pid=13624)[0m             tree[right] = current
[36m(main_task pid=13624)[0m             queue.append(right)
[36m(main_task pid=13624)[0m     # Return the root node of the tree
[36m(main_task pid=13624)[0m     return tree[0]
