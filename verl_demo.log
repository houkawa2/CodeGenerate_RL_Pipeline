[36m(main_task pid=13624)[0m def simulate_movement(room):
[36m(main_task pid=13624)[0m     h, w = len(room), len(room[0])
[36m(main_task pid=13624)[0m     x, y = 0, 0
[36m(main_task pid=13624)[0m     direction = None
[36m(main_task pid=13624)[0m     
[36m(main_task pid=13624)[0m     for row in room:
[36m(main_task pid=13624)[0m         for char in row:
[36m(main_task pid=13624)[0m             if char == '>':
[36m(main_task pid=13624)[0m                 direction = 'east'
[36m(main_task pid=13624)[0m             elif char == '<':
[36m(main_task pid=13624)[0m                 direction = 'west'
[36m(main_task pid=13624)[0m             elif char == '^':
[36m(main_task pid=13624)[0m                 direction = 'north'
[36m(main_task pid=13624)[0m             elif char == 'v':
[36m(main_task pid=13624)[0m                 direction = 'south'
[36m(main_task pid=13624)[0m             elif char == '.':
[36m(main_task pid=13624)[0m                 pass
[36m(main_task pid=13624)[0m             else:
[36m(main_task pid=13624)[0m                 return 'LOOP'
[36m(main_task pid=13624)[0m     
[36m(main_task pid=13624)[0m     if direction == 'east':
[36m(main_task pid=13624)[0m         x += 1
[36m(main_task pid=13624)[0m     elif direction == 'west':
[36m(main_task pid=13624)[0m         x -= 1
[36m(main_task pid=13624)[0m     elif direction == 'north':
[36m(main_task pid=13624)[0m         y -= 1
[36m(main_task pid=13624)[0m     elif direction == 'south':
[36m(main_task pid=13624)[0m         y += 1
[36m(main_task pid=13624)[0m     
[36m(main_task pid=13624)[0m     return x, y
