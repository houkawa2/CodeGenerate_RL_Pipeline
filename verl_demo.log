[36m(main_task pid=13624)[0m Assistant: Let me solve this step by step.
[36m(main_task pid=13624)[0m <think> I will create a Python function to rotate a matrix in a clock-wise direction. </think>
[36m(main_task pid=13624)[0m <answer>
[36m(main_task pid=13624)[0m def rotate_matrix(matrix, angle):
[36m(main_task pid=13624)[0m     n = len(matrix)
[36m(main_task pid=13624)[0m     result = [[0] * n for _ in range(n)]
[36m(main_task pid=13624)[0m     for i in range(n):
[36m(main_task pid=13624)[0m         for j in range(n):
[36m(main_task pid=13624)[0m             result[(i + angle) % n][(j + angle) % n] = matrix[i][j]
[36m(main_task pid=13624)[0m     return result
