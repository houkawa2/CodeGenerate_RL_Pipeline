[36m(main_task pid=13624)[0m 0 7 4 
[36m(main_task pid=13624)[0m 5 8 5 
[36m(main_task pid=13624)[0m 
[36m(main_task pid=13624)[0m 5 0 4 
[36m(main_task pid=13624)[0m 8 7 6 
[36m(main_task pid=13624)[0m 5 4 1 
[36m(main_task pid=13624)[0m 
[36m(main_task pid=13624)[0m 4 6 1 
