[36m(main_task pid=13624)[0m def sort_stack(stack):
[36m(main_task pid=13624)[0m     sorted_stack = []
[36m(main_task pid=13624)[0m     while stack:
[36m(main_task pid=13624)[0m         max_element = float('-inf')
