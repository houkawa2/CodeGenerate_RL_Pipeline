[36m(main_task pid=13624)[0m 
[36m(main_task pid=13624)[0m There are four Shichi-Go-San numbers not greater than 575: 357, 375, 537 and 573.
[36m(main_task pid=13624)[0m Assistant: Let me solve this step by step.
[36m(main_task pid=13624)[0m <think> </think>
[36m(main_task pid=13624)[0m <answer>
[36m(main_task pid=13624)[0m def count_shichi_go_san(n):
[36m(main_task pid=13624)[0m     count = 0
[36m(main_task pid=13624)[0m     for i in range(1, n+1):
[36m(main_task pid=13624)[0m         if '7' in str(i) and '5' in str(i) and '3' in str(i):
[36m(main_task pid=13624)[0m             count += 1
[36m(main_task pid=13624)[0m     return count
