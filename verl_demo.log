[36m(main_task pid=13624)[0m <answer>
[36m(main_task pid=13624)[0m ```python
[36m(main_task pid=13624)[0m def hex_word_sum(s):
[36m(main_task pid=13624)[0m     sum = 0
[36m(main_task pid=13624)[0m     for word in s.split():
[36m(main_task pid=13624)[0m         if word in ['BAG', 'OF', 'BEES']:
[36m(main_task pid=13624)[0m             sum += int(word, 16)
[36m(main_task pid=13624)[0m     return sum
[36m(main_task pid=13624)[0m ```
