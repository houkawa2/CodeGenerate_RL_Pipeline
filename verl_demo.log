[36m(main_task pid=13624)[0m def stone_removing_game(n, k, m):
[36m(main_task pid=13624)[0m     stones = list(range(1, n+1))
[36m(main_task pid=13624)[0m     current_index = m-1
[36m(main_task pid=13624)[0m     while len(stones) > 1:
[36m(main_task pid=13624)[0m         stones.pop(current_index)
[36m(main_task pid=13624)[0m         current_index = (current_index + k-1) % len(stones)
[36m(main_task pid=13624)[0m     return stones[0]
